    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "splash",
    "boot-animation",
    "kassel"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
